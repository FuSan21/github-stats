# GitHub username the cards are allowed to render. Every other username gets 403.
GITHUB_USER=FuSan21

# Classic personal access token for GITHUB_USER with scopes: repo, read:user.
# It must belong to GITHUB_USER: GitHub only includes private repositories and
# private contributions when the token's owner is the user being queried.
GITHUB_TOKEN=

# Starting value for the profile view counter, read only when the views-data
# volume is empty (carries the count over from komarev.com).
INITIAL_VIEWS=0

TZ=Asia/Dhaka
